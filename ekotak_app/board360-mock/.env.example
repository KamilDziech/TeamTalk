# Skopiuj jako .env i dostosuj. Wszystkie wartości mają sensowne domyślne —
# `docker compose up` działa też bez tego pliku.

# Port wystawiony na hoście (w kontenerze zawsze 3001).
MOCK_PORT=3001

# Sekret podpisu tokenu sesji (cookie b360_session / Bearer).
# Zmiana unieważnia tokeny zapisane w telefonach.
SESSION_SECRET=dev-insecure-secret-change-me

# Czas życia sesji mobilnej w sekundach (domyślnie 30 dni).
MOBILE_SESSION_TTL=2592000

# Blokady walidacyjne przejść etapu (422 + missing[]). 0 = wyłącz.
STAGE_GATES=1

# Udawana transkrypcja po wgraniu nagrania (board360 robi to Whisperem). 0 = wyłącz.
MOCK_TRANSCRIPT=1

# Log każdego żądania na stdout.
LOG_REQUESTS=1

TZ=Europe/Warsaw
