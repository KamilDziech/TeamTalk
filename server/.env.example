# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teamtalk
DB_USER=teamtalk
DB_PASSWORD=change_me

# Server
PORT=3000
# For local development use: http://localhost:3000
# For production use public IP/domain

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# OpenAI (for audio transcription)
OPENAI_API_KEY=sk-proj-...

# Audio storage directory (absolute path)
UPLOADS_DIR=./uploads
